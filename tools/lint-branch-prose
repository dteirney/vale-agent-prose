#!/usr/bin/env bash
#
# Lint the prose this branch added, and report only alerts on added lines.
set -euo pipefail
IFS=$'\n\t'

readonly PROG="${0##*/}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

# shellcheck source=lib/prose.sh
source "${SCRIPT_DIR}/../lib/prose.sh"
# shellcheck source=lib/sysexits.sh
source "${SCRIPT_DIR}/../lib/sysexits.sh"

readonly DEFAULT_LIMIT=40

usage() {
  cat <<EOF
usage: ${PROG} [--base <ref>] [--limit <n>] [--by-file] [--data-dir <dir>] [<path>...]
       ${PROG} -h

Lint the prose this branch added, uncommitted edits to tracked files included.
Vale reads the comments in a source file and the whole of a markdown file.
Alerts on lines the branch did not touch are dropped, so an old comment in a
file you edited stays out of the report. Name paths to lint only what the
branch added to them. A directory is walked. Each alert names its file from
the directory you run ${PROG} in, so you can pass that path back.

  --base <ref>      compare against <ref> rather than the default branch
  --limit <n>       print at most <n> alerts, 0 for all (default ${DEFAULT_LIMIT})
  --by-file         print only '<count> <path>' for each file with a Vale
                    alert, highest count first, and every file whatever the
                    limit
  --data-dir <dir>  where Vale finds no config in the repository, use the
                    default one in <dir>, the plugin's data directory
  -h, --help        print this and exit

Past the limit it prints a count per rule instead of the rest. One rule with
hundreds of hits is a question about that rule, not about hundreds of lines.

Exit 0 when clean, 1 when it reports an alert, and a sysexits(3) code on
failure: 64 on a usage error, outside a repository or with a path outside it,
66 when a path or the data directory doesn't exist, 69 when git or vale is
missing, 70 when git fails. --by-file leaves out cspell alerts but still exits
1 on them.
EOF
}

# A usage error: what the caller passed cannot be acted on.
usage_error() {
  printf '%s: %s\n' "${PROG}" "$1" >&2
  usage >&2
  exit "${EX_USAGE}"
}

# A runtime failure: the arguments were fine and the work failed. Print message
# $2 and exit with code $1.
die() {
  printf '%s: %s\n' "${PROG}" "$2" >&2
  exit "$1"
}

default_base() {
  local ref
  for ref in origin/main origin/master main master; do
    if git rev-parse --verify --quiet "${ref}" >/dev/null; then
      printf '%s\n' "${ref}"
      return 0
    fi
  done
  die "${EX_USAGE}" 'no default branch found, so pass --base <ref>'
}

# Print the alerts on stdin with each path relative to directory $1, not to the
# repository root. A path then works as an operand to this command.
relative_paths() {
  local dir="$1" alerts
  alerts="$(cat)"

  local paths
  paths="$(awk -F: '!seen[$1]++ { print $1 }' <<<"${alerts}")"

  local map='' path shown
  while IFS= read -r path; do
    shown="$(git -C "${dir}" ls-files -z -- ":(top,literal)${path}" \
      | tr -d '\0')" || return 1
    map+="${path}"$'\t'"${shown:-${path}}"$'\n'
  done <<<"${paths}"

  # ENVIRON, because awk -v reads a backslash in a path as an escape.
  PROSE_MAP="${map}" awk '
    BEGIN {
      count = split(ENVIRON["PROSE_MAP"], rows, "\n")
      for (k = 1; k <= count; k++)
        if (split(rows[k], f, "\t") == 2) to[f[1]] = f[2]
    }
    {
      i = index($0, ":")
      path = substr($0, 1, i - 1)
      print ((path in to) ? to[path] : path) substr($0, i)
    }' <<<"${alerts}"
}

main() {
  local base=''
  local limit="${DEFAULT_LIMIT}"
  local by_file=0
  local data_dir=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        return 0
        ;;
      --by-file) by_file=1 ;;
      --data-dir)
        [[ $# -ge 2 ]] || usage_error '--data-dir needs a directory'
        data_dir="$2"
        shift
        ;;
      --base)
        [[ $# -ge 2 ]] || usage_error '--base needs a ref'
        base="$2"
        shift
        ;;
      --limit)
        [[ $# -ge 2 ]] || usage_error '--limit needs a count'
        [[ "$2" =~ ^[0-9]+$ ]] || usage_error "--limit wants a number, got '$2'"
        limit="$2"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        usage_error "unknown option '$1'"
        ;;
      *)
        break
        ;;
    esac
    shift
  done

  command -v git >/dev/null || die "${EX_UNAVAILABLE}" 'git is required'
  command -v vale >/dev/null || die "${EX_UNAVAILABLE}" 'vale is required'

  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "${EX_USAGE}" 'not inside a git repository'

  local operand
  for operand in "$@"; do
    [[ -e "${operand}" ]] || die "${EX_NOINPUT}" "no such path '${operand}'"
    git --literal-pathspecs ls-files -- "${operand}" >/dev/null 2>&1 \
      || die "${EX_USAGE}" "'${operand}' is outside the repository"
  done

  # Absolute, because the lint runs from the repository root.
  if [[ -n "${data_dir}" ]]; then
    data_dir="$(cd "${data_dir}" 2>/dev/null && pwd)" \
      || die "${EX_NOINPUT}" "no such directory '${data_dir}'"
  fi

  [[ -n "${base}" ]] || base="$(default_base)"
  git rev-parse --verify --quiet "${base}" >/dev/null \
    || usage_error "unknown ref '${base}'"

  # The linters read the working tree, so the diff has to end there too. A
  # diff ending at `HEAD` puts an uncommitted line's alerts on the wrong line.
  local fork
  fork="$(git merge-base "${base}" HEAD)" \
    || die "${EX_SOFTWARE}" "no common ancestor with '${base}'"

  # Capture before the loop. A process substitution hides git's exit status,
  # so a failed diff would give an empty file list and report clean.
  # --diff-filter=d drops a deleted file, which has no lines left to lint.
  # The operands start from the caller's directory, so the diff runs there.
  # --no-relative stops diff.relative from printing the files from there too.
  local changed
  changed="$(git --literal-pathspecs diff --name-only --no-relative \
    --diff-filter=d "${fork}" -- "$@")" \
    || die "${EX_SOFTWARE}" "git diff against '${base}' failed"
  local cwd="${PWD}"
  cd "${root}"
  if [[ -n "${data_dir}" ]]; then
    prose::use_default_config "${data_dir}/vale/.vale.ini"
  fi

  local -a files=()
  local line
  while IFS= read -r line; do
    if [[ -n "${line}" ]]; then
      files+=("${line}")
    fi
  done <<<"${changed}"

  [[ ${#files[@]} -gt 0 ]] || return 0

  # Vale exits non-zero on an alert, so its status says nothing about
  # whether the run worked. The alerts themselves are the signal.
  local alerts
  # shellcheck disable=SC2310  # it swallows a linter's exit on an alert
  alerts="$(prose::lint_files "${files[@]}" \
    | prose::filter_touched "${fork}")" \
    || die "${EX_SOFTWARE}" 'git diff failed while filtering the alerts'

  [[ -n "${alerts}" ]] || return 0

  # shellcheck disable=SC2310  # it returns 1 itself when git fails
  alerts="$(relative_paths "${cwd}" <<<"${alerts}")" \
    || die "${EX_SOFTWARE}" 'git ls-files failed while naming the files'

  if [[ "${by_file}" -eq 1 ]]; then
    prose::report_by_file <<<"${alerts}"
  else
    prose::report "${limit}" "${alerts}"
  fi
  return 1
}

main "$@"
