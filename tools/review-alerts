#!/usr/bin/env bash
#
# Rank the rules whose alerts the agent leaves standing, from the recheck
# lines the prose hook leaves in every session transcript on this machine.
#
#   tools/review-alerts
#   tools/review-alerts --limit 20
set -euo pipefail
IFS=$'\n\t'

readonly PROG="${0##*/}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

# shellcheck source=lib/prose.sh
source "${SCRIPT_DIR}/../lib/prose.sh"
# shellcheck source=lib/sysexits.sh
source "${SCRIPT_DIR}/../lib/sysexits.sh"

# Below this, one persisted alert could put a rule at the top.
readonly MIN_RECHECKS=5
readonly DEFAULT_LIMIT=10
readonly DEFAULT_ALERT_LIMIT=5

usage() {
  cat <<EOF
usage: ${PROG} [--limit <n>] [--alert-limit <n>]
       ${PROG} -h

Rank rules by how often their alerts persist, from the rechecks the prose hook
left in every session transcript under ${CLAUDE_CONFIG_DIR:-~/.claude}/projects.
Only rechecks from this version of the plugin count, and a rule needs
${MIN_RECHECKS} of them to rank. Each rule prints its persistence rate, the
repositories its persisted alerts came from with the configuration each used,
then its persisted alerts with their lines, the most frequent first.

  --limit <n>          print at most <n> rules, 0 for all (default ${DEFAULT_LIMIT})
  --alert-limit <n>    print at most <n> persisted alerts under each rule, 0
                       for all (default ${DEFAULT_ALERT_LIMIT})
  -h, --help           print this and exit

Exit 0 when it reports, rechecks or none, and a sysexits(3) code on failure:
64 on a usage error, 69 when jq is missing, 70 when it can't read the plugin
version or rank or print the rules, 74 when it can't read the transcripts.
EOF
}

usage_error() {
  printf '%s: %s\n' "${PROG}" "$1" >&2
  usage >&2
  exit "${EX_USAGE}"
}

# Print message $2 and exit with code $1.
die() {
  printf '%s: %s\n' "${PROG}" "$2" >&2
  exit "$1"
}

# Print each recheck line the prose hook left in the transcripts under $1, from
# plugin version $2. A subagent's transcript sits in a folder below its parent's.
read_rechecks() {
  # The transcripts run to gigabytes, so grep picks the lines before jq parses
  # any. The stderr is a JSON string inside the record, so its quotes arrive
  # escaped. grep exits 1 for a batch of transcripts with no recheck in it.
  local lines
  lines="$(find "$1" -type f -name '*.jsonl' \
    -exec grep -hF '\"recheck\":' {} +)" || true
  [[ -n "${lines}" ]] || return 0

  jq -R -c --arg version "$2" '
    fromjson? | .attachment? | objects
    | select(.type == "hook_success"
      and (.command | strings | endswith("/scripts/lint-prose.sh")))
    | .stderr | strings | split("\n")[] | fromjson? | objects
    | select(.version == $version
      and (.recheck == "persisted" or .recheck == "absent"))
  ' <<<"${lines}"
}

# Print one JSON line per rule with enough rechecks to rank, highest
# persistence rate first, from the recheck lines on stdin. A rule's alerts
# are its persisted ones, each alert once with the times it persisted.
rank() {
  jq -s -c --argjson min_rechecks "${MIN_RECHECKS}" '
    group_by(.rule)
    | map(map(select(.recheck == "persisted")) as $persisted
      | {rule: .[0].rule, rechecks: length, persisted: ($persisted | length),
        repositories: ($persisted | group_by(.root)
          | map({root: .[0].root, persisted: length,
            configs: (group_by(.config) | sort_by(-length, .[0].config)
              | map(.[0].config))})
          | sort_by(-.persisted, .root)),
        alerts: ($persisted | group_by([.file, .message, .lines])
          | map(.[0] + {times: length})
          | sort_by(-.times, .file, .lines[0].line))})
    | map(select(.rechecks >= $min_rechecks))
    | sort_by(-(.persisted / .rechecks), -.rechecks, .rule)
    | .[]'
}

# Print one rule from rank in $1: its persistence rate, the repositories its
# persisted alerts came from, then its persisted alerts with their lines.
# $2 caps the alerts where it isn't 0.
print_rule() {
  local rule fields name persisted rechecks rate left_out
  rule="$(jq -c --argjson limit "$2" \
    'if $limit == 0 then . else .alerts |= .[:$limit] end' <<<"$1")" \
    || return 1
  # A printed alert stands for every time it persisted, so the alerts left
  # out are the persisted ones the printed alerts don't account for.
  fields="$(jq -r '[.rule, .persisted, .rechecks,
    (.persisted * 100 / .rechecks | round),
    .persisted - ([.alerts[].times] | add // 0)] | @tsv' <<<"${rule}")" \
    || return 1
  IFS=$'\t' read -r name persisted rechecks rate left_out <<<"${fields}"
  # shellcheck disable=SC2310  # the caller exits on any failure
  prose::message review-alerts/rule "${name}" "${persisted}" "${rechecks}" \
    "${rate}" || return 1
  local repositories
  repositories="$(jq -r '.repositories[]
    | "  \(.root // "outside any repository"): \(.persisted) persisted,"
      + " \(.configs | join(" and ")) configuration"
      + (if (.configs | length) > 1 then "s" else "" end)
  ' <<<"${rule}")" || return 1
  if [[ -n "${repositories}" ]]; then
    # shellcheck disable=SC2310  # the caller exits on any failure
    prose::message review-alerts/repositories || return 1
    printf '%s\n' "${repositories}"
  fi
  jq -r '.alerts[]
    | "",
      "  \(.file)\(if .times > 1 then " (persisted \(.times) times)" else "" end)",
      "  \(.message)",
      (.line as $at | .lines[]
        | (if .line == $at then "  > " else "    " end) + "\(.line) |"
          + (if .text == "" then "" else " \(.text)" end))
  ' <<<"${rule}" || return 1
  if [[ "${left_out}" -gt 0 ]]; then
    printf '\n'
    # shellcheck disable=SC2310  # the caller exits on any failure
    prose::message review-alerts/more-alerts "${left_out}" || return 1
  fi
  printf '\n'
}

# Print the ranked rules in $1, at most $2 of them where $2 isn't 0. $3 caps
# the persisted alerts under each rule where it isn't 0.
print_rules() {
  local rule shown=0 total
  total="$(wc -l <<<"$1")"
  total="${total// /}"
  while IFS= read -r rule; do
    if [[ "$2" -ne 0 && "${shown}" -ge "$2" ]]; then
      prose::message review-alerts/more-rules "$((total - shown))"
      return 0
    fi
    # shellcheck disable=SC2310  # its failures exit here
    print_rule "${rule}" "$3" || die "${EX_SOFTWARE}" 'cannot print a rule'
    shown=$((shown + 1))
  done <<<"$1"
}

main() {
  local limit="${DEFAULT_LIMIT}" alert_limit="${DEFAULT_ALERT_LIMIT}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        return 0
        ;;
      --limit)
        [[ $# -ge 2 ]] || usage_error '--limit needs a count'
        [[ "$2" =~ ^[0-9]+$ ]] || usage_error "--limit wants a number, got '$2'"
        # Bash arithmetic reads a leading zero as octal, and 08 isn't octal.
        limit="$((10#$2))"
        shift
        ;;
      --alert-limit)
        [[ $# -ge 2 ]] || usage_error '--alert-limit needs a count'
        [[ "$2" =~ ^[0-9]+$ ]] \
          || usage_error "--alert-limit wants a number, got '$2'"
        alert_limit="$2"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*) usage_error "unknown option '$1'" ;;
      *) break ;;
    esac
    shift
  done
  [[ $# -eq 0 ]] || usage_error "expected no operands, got $#"

  command -v jq >/dev/null || die "${EX_UNAVAILABLE}" 'jq is required'

  local version
  version="$(jq -r .version "${SCRIPT_DIR}/../.claude-plugin/plugin.json")" \
    || die "${EX_SOFTWARE}" 'cannot read the plugin version'

  local projects="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/projects"
  local rechecks=''
  if [[ -d "${projects}" ]]; then
    # shellcheck disable=SC2310  # its failures exit here
    rechecks="$(read_rechecks "${projects}" "${version}")" \
      || die "${EX_IOERR}" "cannot read the transcripts under ${projects}"
  fi
  if [[ -z "${rechecks}" ]]; then
    prose::message review-alerts/no-records "${projects}" "${version}"
    return 0
  fi

  local rules
  # shellcheck disable=SC2310  # its failures exit here
  rules="$(rank <<<"${rechecks}")" || die "${EX_SOFTWARE}" 'cannot rank the rechecks'
  if [[ -z "${rules}" ]]; then
    local count
    count="$(wc -l <<<"${rechecks}")"
    prose::message review-alerts/none-ranked "${projects}" "${count// /}" \
      "${version}" "${MIN_RECHECKS}"
    return 0
  fi
  print_rules "${rules}" "${limit}" "${alert_limit}"
}

main "$@"
