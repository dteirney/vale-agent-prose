#!/usr/bin/env bash
#
# Run the commit-message prose check from every repository, through a hook in
# the user's global git config.
#
#   tools/commit-hook install ~/.claude/plugins/data/<id>
set -euo pipefail
IFS=$'\n\t'

readonly PROG="${0##*/}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

# shellcheck source=lib/prose.sh
source "${SCRIPT_DIR}/../lib/prose.sh"
# shellcheck source=lib/sysexits.sh
source "${SCRIPT_DIR}/../lib/sysexits.sh"

# A friendly name, which git refuses when it matches a hook event's name.
readonly HOOK='vale-agent-prose'

# Git reads a hook from config only from this release on.
readonly MIN_GIT='2.54.0'

usage() {
  cat <<EOF
usage: ${PROG} install <dir>
       ${PROG} refresh <dir>
       ${PROG} remove
       ${PROG} -h

Run the commit-message prose check before every commit in every repository.

  install <dir>   copy the check into <dir>, and add a commit-msg hook that
                  runs it to your global git config
  refresh <dir>   copy the check into <dir> where it differs, and touch no
                  git config
  remove          take the hook out of your global git config

<dir> outlives the copy this command runs from, so the hook keeps working
after an update. The hook skips the check when <dir> is gone, so a commit
still goes through after an uninstall.

  -h, --help   print this and exit

Needs git ${MIN_GIT} or later.

Exit 0 on success, and a sysexits(3) code on failure: 64 on a usage error, 69
when git is missing or too old, 73 when the copy fails, 74 when the git config
write fails.
EOF
}

usage_error() {
  printf '%s: %s\n' "${PROG}" "$1" >&2
  usage >&2
  exit "${EX_USAGE}"
}

# Print message $2 and exit with code $1.
die() {
  printf '%s: %s\n' "${PROG}" "$2" >&2
  exit "$1"
}

# Copy the check and the libraries it sources, keeping their relative layout.
copy_check() {
  local dir="$1" rel
  for rel in tools/lint-commit-prose lib/prose.sh lib/sysexits.sh; do
    if cmp -s "${SCRIPT_DIR}/../${rel}" "${dir}/${rel}"; then
      continue
    fi
    mkdir -p "${dir}/${rel%/*}" || return 1
    cp "${SCRIPT_DIR}/../${rel}" "${dir}/${rel}" || return 1
  done
}

git_new_enough() {
  local out version=''
  out="$(git --version)" || return 1
  if [[ "${out}" =~ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
    version="${BASH_REMATCH[1]}"
  fi
  [[ -n "${version}" ]] || return 1
  printf '%s\n%s\n' "${MIN_GIT}" "${version}" | sort -V -C
}

install() {
  local dir="$1"
  # The path sits inside single quotes in the hook command.
  [[ "${dir}" != *"'"* ]] || usage_error "a quote in '${dir}' would break the hook"

  # shellcheck disable=SC2310  # the failure is handled on the same line
  git_new_enough \
    || die "${EX_UNAVAILABLE}" "git ${MIN_GIT} or later is needed to run a hook from config"
  # shellcheck disable=SC2310  # the failure is handled on the same line
  copy_check "${dir}" || die "${EX_CANTCREAT}" "cannot copy the check into '${dir}'"

  # Git appends the message file to the command, so the function takes it.
  local check="${dir}/tools/lint-commit-prose"
  local command="f() { p='${check}'; [ -x \"\$p\" ] || exit 0; exec \"\$p\" \"\$@\"; }; f"

  git config set --global --all "hook.${HOOK}.event" commit-msg \
    || die "${EX_IOERR}" 'cannot set the hook event in the global git config'
  git config set --global "hook.${HOOK}.command" "${command}" \
    || die "${EX_IOERR}" 'cannot set the hook command in the global git config'
  prose::message commit-hook/installed "${HOOK}" "${check}"
}

refresh() {
  # shellcheck disable=SC2310  # the failure is handled on the same line
  copy_check "$1" || die "${EX_CANTCREAT}" "cannot copy the check into '$1'"
}

remove() {
  if ! git config get --global "hook.${HOOK}.command" >/dev/null 2>&1; then
    prose::message commit-hook/none "${HOOK}"
    return 0
  fi
  git config remove-section --global "hook.${HOOK}" \
    || die "${EX_IOERR}" 'cannot remove the hook from the global git config'
  prose::message commit-hook/removed "${HOOK}"
}

main() {
  [[ $# -gt 0 ]] || usage_error 'expected a subcommand'
  case "$1" in
    -h | --help)
      usage
      return 0
      ;;
    install | refresh)
      [[ $# -eq 2 ]] || usage_error "$1 expects one directory, got $(($# - 1))"
      [[ -n "$2" ]] || usage_error "$1 expects a directory"
      ;;
    remove)
      [[ $# -eq 1 ]] || usage_error 'remove takes no operand'
      ;;
    *) usage_error "unknown subcommand '$1'" ;;
  esac

  command -v git >/dev/null || die "${EX_UNAVAILABLE}" 'git is required'

  case "$1" in
    install) install "$2" ;;
    refresh) refresh "$2" ;;
    remove) remove ;;
    *) ;;
  esac
}

main "$@"
