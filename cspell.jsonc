{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  // Only a name no dictionary could hold. A file whose every builtin flags
  // needs a languageId override below, not its words here.
  "words": [
    "adoc",
    "adposition",
    "argjson",
    "asciidoctor",
    "CANTCREAT",
    "cljc",
    "cljd",
    "clig",
    "commitlint",
    "commitlintrc",
    "Cowork",
    "dteirney",
    "EDITMSG",
    "endswith",
    "errorformat",
    "Flesch",
    "GDAL",
    "getconf",
    "ignorecase",
    "IOERR",
    "Kato",
    "Kincaid",
    "Liau",
    "ltrimstr",
    "mfinelli",
    "NOINPUT",
    "nonword",
    "noprefix",
    "NPROCESSORS",
    "nullary",
    "ONLN",
    "pathspecs",
    "Rakefile",
    "rawfile",
    "rdjsonl",
    "reviewdog",
    "rtrimstr",
    "SCRIPTDIR",
    "slurpfile",
    "textfsm",
    "shellcheck",
    "shfmt",
    "stripspace",
    "Suchow",
    "subordinator",
    "Sunkam",
    "sysexits",
    "Teirney",
    "tfvars",
    "tmpl",
    "toplevel",
    "Tricolon",
    "ungated",
    "unmatch",
    "wayfinder",
  ],

  // Only a --dot run reaches in here, and then it reads the whole object store.
  // A fixture is a copy of what Claude Code wrote, ids and field names included.
  // cspell reads the synced styles despite .gitignore, whose re-include of the
  // vocabulary it doesn't apply as git does.
  "ignorePaths": [".git/**", "tests/fixtures/**", "styles/**"],

  "overrides": [
    // A command and a git hook have no extension, so they get no language, the
    // shell dictionary never loads, and every builtin reads as a misspelling.
    {
      "filename": "{githooks,tools}/*",
      "languageId": "shellscript",
    },

    // cspell maps no language to .bats, and a bats test is bash.
    {
      "filename": "**/*.bats",
      "languageId": "shellscript",
    },

    // A Vale rule single-quotes its regexes and double-quotes its messages, so
    // this skips the patterns and still reads the prose. The match stops at a
    // newline, or an apostrophe in a comment pairs with the next line's quote.
    {
      "filename": "package/styles/**/*.yml",
      "ignoreRegExpList": ["/'[^'\\n]*'/g"],
    },
  ],
}
